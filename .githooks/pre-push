#!/bin/sh
# Run the unit tests before pushing.
# Enable with: git config core.hooksPath .githooks

PHP=${PHP:-php}

if ! command -v "$PHP" >/dev/null 2>&1; then
    echo "pre-push: php not found, unit tests skipped (set PHP=/path/to/php)" >&2
    exit 0
fi

"$PHP" tools/phpunit.phar --testsuite unit --no-progress || {
    echo "pre-push: unit tests failed, push aborted" >&2
    exit 1
}
