# Configuration Carbure pour Synology (MariaDB 10 paquet DSM)
# Copier ce fichier en .env.synology et remplir les valeurs

# Adresse IP du NAS sur le réseau local (ex: 192.168.1.10)
# NE PAS mettre localhost ou 127.0.0.1 : depuis le conteneur, c'est le conteneur lui-même
DB_HOST=192.168.1.10

# Port de MariaDB 10 (défaut 3307 sur Synology, visible dans l'app MariaDB 10)
DB_PORT=3307

# Nom de la base (créée via phpMyAdmin à l'étape 3 du guide)
DB_NAME=carbure

# Utilisateur de la base (créé via phpMyAdmin, hôte 172.17.% ou %)
DB_USER=carbure

# Mot de passe de l'utilisateur carbure (défini à l'étape 3)
DB_PASSWORD=votre_mot_de_passe_solide

# Langue de l'assistant d'installation (fr, en)
LANGUAGE=fr

# Port publié sur le NAS (changer si 8080 déjà utilisé, ex: 8095)
PORT=8080

# Intervalle de synchronisation bancaire en secondes (86400 = 1 jour, vide pour désactiver)
SYNC_INTERVAL=86400